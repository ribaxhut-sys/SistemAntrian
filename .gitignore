# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Virtual environment ----
.venv/
venv/
env/

# ---- Packaging / build ----
build/
dist/
*.egg-info/
*.spec.bak

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Application data (JANGAN di-commit) ----
data/*.db
data/*.db-wal
data/*.db-shm
data/mesin.json
# Peran komputer ini terhadap pengunjung. Sifat SATU mesin, bukan isi
# repositori: peran yang ikut ter-commit akan diwarisi setiap clone, dan
# komputer berikutnya membuka layar milik komputer sebelumnya.
data/peran.json
backup/*.db
backup/*.zip
tiket/
Print hasil/
assets/sounds/*.wav
logs/
*.log

# ---- Media anjungan (diganti kapan saja, bukan isi repositori) ----
# Gambar dan video sambutan maupun per layanan adalah isi yang ditukar
# petugas sewaktu-waktu, bukan bagian dari aplikasi. Ukurannya puluhan
# megabyte dan sekali masuk ia tinggal di riwayat selamanya, bahkan
# sesudah dihapus. `.gitkeep` sengaja dikecualikan supaya foldernya tetap
# ada sesudah clone — `daftar_media_kios()` memang sanggup menghadapi
# folder yang hilang, tetapi folder yang ada lebih jelas bagi pemasang.
media/kiosk/*
!media/kiosk/.gitkeep
VID/

# ---- Keluaran tangkapan layar pengaturan ----
# Ditulis ulang setiap kali tests/test_zz_pratinjau.py dijalankan.
pengaturan-*.png

# ---- Local config / secrets ----
.env
.env.*
config.local.*

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
Desktop.ini
